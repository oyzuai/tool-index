{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyzu.dev/contracts/plugins-v1alpha1/manifest.schema.json",
  "title": "Draft plugin protocol v1alpha1: package manifest",
  "description": "The minimal metadata of one plugin release, checked before launch. No field may name another plugin: plugins never depend on, invoke or prefer another plugin (PLG-CONTRACT-06). OCI media types and release-root layout are later checkpoint outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "identity",
    "protocol_generations",
    "profiles",
    "roles",
    "runtimes",
    "requirements",
    "effects",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "v1alpha1"
    },
    "type": {
      "const": "plugin-manifest"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/pluginIdentity"
    },
    "protocol_generations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/generation"
      }
    },
    "profiles": {
      "description": "Registered profiles. A logical reference is <identity.name>/<profile>. Profile names are unique.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/component"
          },
          "role": {
            "$ref": "common.schema.json#/$defs/role"
          }
        }
      },
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "contract",
          "features"
        ],
        "properties": {
          "role": {
            "$ref": "common.schema.json#/$defs/role"
          },
          "contract": {
            "const": "builder"
          },
          "features": {
            "$ref": "common.schema.json#/$defs/features"
          }
        }
      }
    },
    "runtimes": {
      "description": "Native runtime variants. Core selects only the one matching the invocation location.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "arch",
          "entrypoint",
          "digest"
        ],
        "properties": {
          "os": {
            "enum": [
              "linux",
              "darwin",
              "windows"
            ]
          },
          "arch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "abi": {
            "enum": [
              "gnu",
              "musl",
              "msvc"
            ]
          },
          "min_platform": {
            "description": "Minimum OS release, such as 11.0 for macOS or 2.17 for glibc.",
            "type": "string",
            "pattern": "^[0-9]{1,5}(\\.[0-9]{1,5}){0,3}$"
          },
          "entrypoint": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        }
      }
    },
    "requirements": {
      "description": "Baseline native tools needed whatever the project contains. Source-dependent requirements come from the requirements operation.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "reason"
        ],
        "properties": {
          "tool": {
            "$ref": "common.schema.json#/$defs/tool"
          },
          "constraint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "profiles": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/component"
            }
          },
          "stages": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/stage"
            }
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/message"
          }
        }
      }
    },
    "effects": {
      "description": "Requested effects. They limit what core brokers; they do not remove a native executable's ambient OS access.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "reason"
        ],
        "properties": {
          "effect": {
            "enum": [
              "source-read",
              "output-write",
              "native-process",
              "native-network"
            ]
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/message"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "maintainer"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
